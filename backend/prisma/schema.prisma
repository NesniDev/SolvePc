// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Definición de enumeradores para mantener la consistencia de datos
enum Difficulty {
  Fácil
  Medio
  Difícil
}

// Modelo Principal: Solution
model Solution {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  description String
  category    String
  difficulty  Difficulty
  image       String?
  so          String

  // Relación 1:1 con Explain
  explain     Explain?   
}

// Modelo Secundario: Explain
model Explain {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  photo         String?
  terminal      String?
  
  // PostgreSQL permite almacenar arrays directamente
  prerequisites String[] 
  steps         String[] 

  // Llave foránea para conectar con Solution
  solutionId    Int      @unique
  solution      Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  // Relación 1:N con CommonError
  commonErrors  CommonError[]
}

// Modelo Terciario: CommonError
model CommonError {
  id          Int      @id @default(autoincrement())
  code        String
  label       String
  percentage  String

  // Llave foránea para conectar con Explain
  explainId   Int
  explain     Explain  @relation(fields: [explainId], references: [id], onDelete: Cascade)
}