---
import ArrowRight from '@assets/buttons/Arrow-right.astro'
import Input from '@components/ui/Input.astro'
import { SearchProblem } from '@components/ui/SearchProblem'
import { problemasTecnicos } from '@mockup/solutions'
import { transform } from 'astro:schema'
---

<main>
  <div class="badge">
    <h2><span>●</span> v1.0 — Base de diagnósticos</h2>
  </div>

  <section class="hero">
    <h1 class="title">
      <span>Errores técnicos,</span>
      <span>documentados y resueltos.</span>
    </h1>
    <p>
      SolvePc es una plataforma web que permite buscar problemas técnicos de tu
      computadora en lenguaje sencillo y obtener soluciones claras paso a paso.
      Busca el código de error o describe los síntomas para consultar las
      posibles causas y soluciones recomendadas.
    </p>
  </section>
  <SearchProblem
    placeholder="Describa el problema de su computadora. Ej: no enciende..."
    size="big"
    redirectTo="/problemas"
    datosSugerencias={problemasTecnicos}
    client:load
  />
  <div class="links-try">
    <div class="links">
      {
        problemasTecnicos.slice(0, 4).map((sug) => {
          return (
            <span>
              <span>🔍</span> {sug.title}
            </span>
          )
        })
      }
    </div>
  </div>
</main>
<style>
  main {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-top: 100px;
    margin-bottom: 50px;
  }

  .badge {
    display: inline;
    text-align: center;
    border-radius: 90px;
    background-color: var(--background);
    border: 1px solid var(--gray-border);
    backdrop-filter: blur(1px);
    margin-bottom: -20px;
  }

  .badge h2 {
    padding: 0 15px;
    color: var(--gray-letter);
    font-size: 12px;
    text-transform: uppercase;
    font-weight: 400;
    font-family: 'JetBrains Mono Variable', monospace;
    letter-spacing: 2px;
  }

  h2 span {
    color: #15ff00;
    filter: drop-shadow(0 0 2px rgb(19, 255, 11));
  }

  .title {
    font-size: 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-family: 'Bangers', system-ui;
    letter-spacing: 2px;

    span {
      line-height: 1;
      &:nth-child(1) {
        color: var(--color-white);
      }
      &:nth-child(2) {
        color: var(--color-hard);
        filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.548));
      }
    }
  }
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
  }

  .hero > h1 ~ p {
    margin: 0;
    margin-top: -35px;
    text-align: center;
    color: var(--gray-letter);
    line-height: 1.5;
    letter-spacing: 1px;
    width: 65%;
    font-family: 'Grandstander Variable', system-ui;
  }

  /* links try */
  .links-try {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    text-align: center;
    color: #949494;
    width: 80%;
    font-family: 'Grandstander Variable', system-ui;
    & .links {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      & > span {
        text-decoration: none;
        color: #949494;
        background-color: transparent;
        padding: 5px 10px;
        border-radius: 15px;
        border: 1px solid #505050;
        transition: all 0.3s ease-in-out;
        will-change: transform;
        &:hover {
          background-color: #091420;
          border: 1px solid #00eaff41;
          transform: scale(1.02);
        }
      }
    }
  }
</style>
