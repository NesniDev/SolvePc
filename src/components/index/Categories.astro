---
import { categories } from '@mockup/categories'
---

<section>
  <h2>Categorías</h2>
  <div class="categories">
    {
      categories.map(({ name, icon, articles }) => (
        <div class="category">
          <div>
            <img src="/categories/arrow-link.svg" alt="Icono de Hardware" />
          </div>
          <img src={icon} alt="Icono de Hardware" />
          <h3>{name}</h3>
          <p>{articles} Articulos</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin: 10px auto;
    h2 {
      font-size: 30px;
      letter-spacing: 2px;
      margin: 22px 0;
      color: #eef7fb;
      font-family: 'Bangers', system-ui;
    }
  }

  .categories {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    gap: 10px;
    width: 120%;
    font-family: 'bangers', system-ui;
  }

  .category {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 10px;
    width: 300px;
    background-color: #0e1c2e;
    border-radius: 15px;
    padding: 20px;
    position: relative;
    transition: all 0.3s ease-in-out;
    will-change: transform;
    border: 1px solid transparent;
    &:hover {
      background-color: #0e1c2e;
      transform: scale(1.02);
      box-shadow: 0 0 10px rgba(0, 255, 255, 0.548);
      border-radius: 15px;
      border: 1px solid rgba(0, 255, 255);
    }
    & div > img {
      position: absolute;
      transform: rotate(-45deg);
      top: 10px;
      right: 10px;
      width: 25px;
      height: 25px;
      opacity: 0;
      transition: all 0.3s ease-in-out;
      cursor: pointer;
      &:hover {
        transform: rotate(-90deg);
      }
    }
    &:hover div > img {
      opacity: 1;
    }
    & img {
      width: 25px;
      filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.548));
    }
    & h3 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #eef7fb;
      margin: 0;
    }
    & p {
      font-size: 10px;
      text-transform: lowercase;
      color: #949494;
      font-family: 'JetBrains Mono Variable', monospace;
      margin: 0;
    }
  }
</style>
