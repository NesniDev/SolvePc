---
const links = [
  { href: '/', text: 'Inicio' },
  { href: '/diagnosticar-error', text: 'Diagnosticar' },
  { href: '/acerca-de', text: 'Nosotros' }
]

const path = Astro.url.pathname

const repo = 'NesniDev/SolvePc'
---

<header>
  <nav>
    <img class="logo" src="/logo.svg" alt="Logo de Solve Pc" />
    <ul>
      {
        links.map(({ href, text }) => (
          <li>
            <a href={href} class:list={['font', { active: path === href }]}>
              {text}
            </a>
            <span />
          </li>
        ))
      }
    </ul>
    <div class="right">
      <a href="/reportar-error" class="button">Reportar Error</a>
      <a href={`https://github.com/${repo}`} class="github" target="_blank">
        <img
          src={`https://img.shields.io/github/stars/${repo}?style=social`}
          alt="GitHub Stars"
        />
      </a>
    </div>
  </nav>
</header>

<style>
  .right {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }
  .logo {
    width: 45px;
    filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.548));
  }

  .right .github {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    img {
      width: 80px;
      filter: drop-shadow(0 0 8px rgba(0, 255, 255, 0.548));
    }
  }

  .right .button {
    background-color: #00e8ff;
    padding: 7px 10px;
    color: #0d1b2a;
    font-weight: 500;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    transition: all 0.3s ease-in-out;
    will-change: transform;
    &:hover {
      background-color: #ff0000;
      color: #eef7fb;
      transform: translateY(-3px);
    }
  }

  header {
    background-color: #0d1b2a;
    border-bottom: 1px solid #90a7b217;
    font-family: 'Bangers', system-ui;
  }

  nav {
    padding: 15px 0;
    display: flex;
    justify-content: space-around;
    align-items: center;
  }

  ul {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 50px;
  }

  li {
    list-style: none;
  }

  a {
    position: relative;
    text-decoration: none;
    color: #90a7b2;

    padding-bottom: 8px;
    transition: color 0.2s ease-in-out;
  }

  .font {
    font-size: 15px;
  }

  .active::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(5, 253, 232),
      transparent
    );
    transition: width 0.3s ease;
  }

  a.active {
    color: #eef7fb;
  }

  a.active::after {
    width: 100%;
    color: transparent;
  }

  a:hover {
    color: #eef7fb;
  }
</style>
