---
import type { Explain } from 'src/interfaces/Solutions'

interface Props {
  explain: Explain
}

const { explain } = Astro.props
const { steps } = explain
---

<section class="steps-solutions">
  <h2 id="ruta-solucion">Ruta de Solución</h2>
  <h3>Solución paso a paso</h3>
  <ol class="steps">
    {
      steps.map((step, index) => (
        <li class="step">
          <span class="leccion-check">Leido</span>
          <div class="step-info">
            {index < 10 ? (
              <span class="number">0{index + 1}</span>
            ) : (
              <span class="number">{index + 1}</span>
            )}
            <span class="step-text">{step}</span>
          </div>
          <div class="step-check">
            <input type="checkbox" />
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps-solutions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    font-family: 'Bangers', monospace;
    h2 {
      font-size: 0.7rem;
      margin: 0;
      padding: 0;
      color: var(--color-hard);
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 0.1rem;
    }

    & h3 {
      font-size: 1rem;
      margin: 20px 0;
      color: var(--color-white);
    }

    & .steps {
      list-style: none;
      padding: 0;
      font-size: 0.8rem;
      display: flex;
      flex-direction: column;
      align-items: start;
      justify-content: center;
      width: 100%;
      gap: 1.4rem;
      font-family: 'Grandstander Variable', system-ui;

      & .step {
        color: var(--gray-letter);
        margin: 0;
        padding: 0;
        display: flex;
        position: relative;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        background-color: #1a355542;
        border: 1px solid var(--gray-border);
        border-radius: 15px;
        padding: 1rem;
        transition: all 0.2s ease-in-out;

        &:has(input:checked) .leccion-check {
          transform: translateY(-21px);
          background-color: green;
          opacity: 1;
        }

        & > .leccion-check {
          position: absolute;
          top: 0px;
          right: 10px;
          width: 60px;
          height: 20px;
          color: white;
          display: flex;
          justify-content: center;
          align-items: center;
          border-radius: 10px 10px 0 0;
          transition: all 0.4s ease-in-out;
          opacity: 0;
          z-index: -1;
          box-shadow: 0 0 2px rgb(51, 255, 0);
        }

        &.backgroundUi {
          background-color: rgba(0, 255, 76, 0.068);
          color: rgb(0, 255, 0);
        }

        & .step-info {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.4rem;
        }
        & .step-check input {
          appearance: none;
          -webkit-appearance: none;
          width: 20px;
          height: 20px;
          border: 2px solid #cbd5e1;
          border-radius: 6px;
          cursor: pointer;
          transition: all 0.2s ease;
          /* hover */
          &:hover {
            border-color: #94a3b8;
            box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.15);
          }
          /* check activo */
          &:checked {
            background-color: #22c55e;
          }
        }

        & div > span:first-child {
          display: flex;
          align-items: center;
          justify-content: center;
          color: var(--color-hard);
          font-size: 1rem;
          font-weight: 700;
          background-color: #1a3755; /* #0d1b2a80; */
          border: 1px solid var(--color-hard);
          backdrop-filter: blur(1px);
          border-radius: 10px;
          padding: 0.2rem 0.8rem;
          width: 30px;
          height: 30px;
          width: auto;
          font-family: 'JetBrains Mono Variable', monospace;
        }

        & div > span:last-child {
          font-size: 1rem;
        }
      }
    }
  }

  @keyframes myAnimation {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-10px);
    }
  }
</style>

<script>
  interface Items {
    id: string
    steps: string[]
    percentage: number
  }
  document.addEventListener('astro:page-load', () => {
    const borde = document.querySelector('.completed') as HTMLDivElement
    if (!borde) return
    const textCompleted = document.querySelector('.completed span')

    const $title = document.querySelector(
      '.title-problem'
    ) as HTMLHeadingElement

    const listLength = document.querySelectorAll('.step')
    if (!listLength) return

    const contentTitle = $title?.textContent?.trim()
    if (!contentTitle) return

    let stepsState = JSON.parse(localStorage.getItem('info') ?? '[]')

    let currentItem: Items = stepsState.find(
      (item: any) => item.id === contentTitle
    )

    if (!currentItem) {
      currentItem = {
        id: contentTitle,
        steps: [],
        percentage: 0
      }

      stepsState.push(currentItem)
    }

    const updatePercentage = () => {
      const completed = currentItem.steps.length

      const total = listLength.length

      const percentage = Math.round((completed / total) * 100)

      currentItem.percentage = percentage

      if (textCompleted) {
        if (percentage >= 100) {
          borde.style.borderColor = 'rgb(0, 255, 0)'
        } else if (percentage < 40) {
          borde.style.borderColor = 'red'
        } else {
          borde.style.borderColor = 'orange'
        }
        textCompleted.textContent = `${percentage}%`
      }

      localStorage.setItem('info', JSON.stringify(stepsState))
    }

    const stepsSection = document.querySelector(
      '.steps-solutions'
    ) as HTMLDivElement

    const items = stepsSection.querySelectorAll('li')

    items.forEach((item) => {
      const text = item.querySelector('.step-text')?.textContent?.trim()
      if (!text) return
      const input = item.querySelector('input')

      if (currentItem.steps.includes(text)) {
        item.classList.add('backgroundUi')
        if (input) input.checked = true
      } else {
        item.classList.remove('backgroundUi')
        if (input) input.checked = false
      }
      updatePercentage()
    })

    stepsSection?.addEventListener('change', (e: Event) => {
      const element = e.target as HTMLElement

      if (!element.matches('input')) return

      const li = element.closest('li')

      if (!li) return

      const textElement =
        (li.querySelector('.step-info > .step-text') as HTMLSpanElement) ?? ''

      const text = textElement?.textContent ?? ''

      if (!text) return

      if (element.checked) {
        li.classList.add('backgroundUi')
        if (!currentItem.steps.includes(text)) {
          currentItem.steps.push(text)
        }
      } else {
        li.classList.remove('backgroundUi')
        currentItem.steps = currentItem.steps.filter((item) => item !== text)
      }

      updatePercentage()
      localStorage.setItem('info', JSON.stringify(stepsState))
    })
  })
</script>
