---
import type { Explain } from 'src/interfaces/Solutions'

interface Props {
  explain: Explain
}

const { explain } = Astro.props
const { steps } = explain
---

<section class="steps-solutions">
  <h2 id="ruta-solucion">Ruta de Solución</h2>
  <h3>Solución paso a paso</h3>
  <ol class="steps">
    {
      steps.map((step, index) => (
        <li class="step">
          <div class="step-info">
            {index < 10 ? <span>0{index + 1}</span> : <span>{index + 1}</span>}
            <span class="step-text">{step}</span>
          </div>
          <div class="step-check">
            <input type="checkbox" />
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps-solutions {
    width: 100%;
    font-family: 'Bangers', monospace;
    h2 {
      font-size: 0.7rem;
      margin: 0;
      padding: 0;
      color: var(--color-hard);
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 0.1rem;
    }

    & h3 {
      font-size: 1rem;
      margin: 20px 0;
      color: var(--color-white);
    }

    & .steps {
      list-style: none;
      padding: 0;
      font-size: 0.8rem;
      display: flex;
      flex-direction: column;
      align-items: start;
      justify-content: center;
      gap: 0.8rem;
      font-family: 'Grandstander Variable', system-ui;

      & .step {
        color: var(--gray-letter);
        margin: 0;
        padding: 0;
        display: flex;

        justify-content: space-between;
        align-items: center;
        gap: 0.6rem;
        background-color: #1a355542;
        border: 1px solid var(--gray-border);
        border-radius: 15px;
        padding: 1rem;
        width: 100%;
        transition: all 0.2s ease-in-out;
        &:hover {
          background-color: #1a3555;
          border: 1px solid var(--color-hard);
        }
        & .step-info {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.4rem;
        }
        & div > span:first-child {
          display: flex;
          align-items: center;
          justify-content: center;
          color: var(--color-hard);
          font-size: 1rem;
          font-weight: 700;
          background-color: #1a3755; /* #0d1b2a80; */
          border: 1px solid var(--color-hard);
          backdrop-filter: blur(1px);
          border-radius: 10px;
          padding: 0.2rem 0.8rem;
          width: 30px;
          height: 30px;
          width: auto;
          font-family: 'JetBrains Mono Variable', monospace;
        }

        & div > span:last-child {
          font-size: 1rem;
        }
      }
    }
  }
</style>
