---
import Header from '../components/layout/Header.astro'
import SEO from '../components/SEO.astro'
import ClientRouter from 'astro/components/ClientRouter.astro'
import '../styles/global.css'
import Footer from '@components/layout/Footer.astro'
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title="Solve Pc - Resuelve todo lo que necesites sobre tu computadora"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="orb1"></div>
    <div class="orb2"></div>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-hard: #00e9ff;
    --color-white: #eef7fb;
    --background: #0d1b2a;
    --gray-border: #505050;
    --gray-letter: #949494;
    --letter-link: #90a7b2;
  }
  body {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    background-color: #0d1b2a;
    background-image:
      linear-gradient(rgba(100, 180, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(100, 180, 255, 0.07) 1px, transparent 1px);
    background-size: 35px 35px;
    margin: 0;
    position: relative;
  }

  /* Orbe 1 — azul arriba izquierda */
  .orb1 {
    position: absolute;
    width: 300px;
    height: 300px;
    background: rgba(0, 180, 255, 0.18);
    border-radius: 50%;
    filter: blur(80px);
    top: -80px;
    left: -60px;
  }

  /* Orbe 2 — violeta abajo derecha */
  .orb2 {
    position: absolute;
    width: 250px;
    height: 250px;
    background: rgba(80, 60, 255, 0.15);
    border-radius: 50%;
    filter: blur(80px);
    bottom: 0;
    right: 60px;
  }
</style>
