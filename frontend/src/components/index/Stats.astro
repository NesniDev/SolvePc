---
const totalSolutions = 15
const verifiedSolutions = 9

const percentage = (9 / totalSolutions) * 100

const stats = [
  {
    title: 'Soluciones Verificadas',
    value: verifiedSolutions
  },
  {
    title: 'Tasa de Resolución',
    value: percentage.toFixed(0) + '%'
  },
  {
    title: 'Tiempo Promedio de Reparación (Min)',
    value: '< 90'
  },
  {
    title: 'Ingenieros Colaboradores',
    value: 2
  }
]
---

<section class="background-card">
  <div class="stats">
    {
      stats.map(({ title, value }) => (
        <article class="stat-card">
          <span>{value}</span>
          <span>{title}</span>
        </article>
      ))
    }
  </div>
</section>

<style>
  .background-card {
    background-color: #1c426641;
    max-width: 1000px;
    border: 1px solid #7577793f;
    backdrop-filter: blur(3px);
    margin: 0 auto;
    padding: 7px;
    border-radius: 15px;
  }

  .stats {
    background-color: #0e1c2e;
    border-radius: 15px;
    color: #fff;
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    font-family: 'Geist Sans', monospace;
    font-size: 35px;
    padding: 15px 0;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    & span:nth-child(1) {
      font-weight: 900;
    }
    & span:last-child {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 400;
      color: #939597;
    }
  }
</style>
