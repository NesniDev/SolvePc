---
export const prerender = false
const solutionsRes = await fetch(
  `${import.meta.env.PUBLIC_API_URL}/api/solutions/all`
)

const categoriesRes = await fetch(
  `${import.meta.env.PUBLIC_API_URL}/api/categories`
)

const categories = await categoriesRes.json()

const solutions = await solutionsRes.json()

const countMap = solutions.reduce((acc: Record<string, number>, sol: any) => {
  acc[sol.category] = (acc[sol.category] || 0) + 1
  return acc
}, {})

const categoriesWithCount = categories.map((cat: any) => ({
  ...cat,
  articlesCount: countMap[cat.slug] || 0
}))
---

<section>
  <div class="wrapper-title">
    <h2>02 / Categorías</h2>
    <h3>Explora toda la base de diagnósticos.</h3>
  </div>

  <div class="categories">
    {
      categoriesWithCount.map(
        ({ name = '', icon = '', articlesCount = 0 }, index = 0) => (
          <article class={`category ${index >= 8 ? 'hidden extra-card' : ''}`}>
            <div>
              <img src="/categories/arrow-link.svg" alt="Icono de Hardware" />
            </div>
            <img src={icon} alt={`Icono de ${name} `} />
            <h3>{name}</h3>
            <p>{articlesCount} Articulos</p>
          </article>
        )
      )
    }

    {
      categoriesWithCount.length > 8 && (
        <div class="wrapper-mostrar">
          <button id="show-more-btn">Mostrar más</button>
        </div>
      )
    }
  </div>
</section>

<style>
  .wrapper-mostrar {
    width: 100%;
    display: block;
    text-align: center;
    button {
      padding: 10px;
      background-color: transparent;
      color: var(--color-white);
      font-family: 'Grandstander Variable', system-ui;
      font-weight: 700;
      border-radius: 5px;
      border: 1px solid #949494;
      cursor: pointer;
      transition: all 0.3s ease-in-out;
      &:hover {
        backdrop-filter: blur(2px);
        background-color: #9494941c;
      }
    }
  }
  .wrapper-title {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: start;
    gap: 10px;
    width: 100%;
    h2 {
      font-size: 15px;
      letter-spacing: 2px;
      margin-top: 40px;
      margin-bottom: 0;
      color: var(--color-hard);
      font-family: 'Bangers', system-ui;
    }
    h3 {
      font-size: 30px;
      margin-top: 10px;
      margin-bottom: 10px;
      color: #eef7fb;
      text-transform: uppercase;
      font-family: 'Grandstander Variable', system-ui;
    }
  }
  section {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    margin-top: 50px;
  }

  .categories {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    width: 100%;
    font-family: 'bangers', system-ui;
    flex-wrap: wrap;
  }

  .category {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 10px;
    width: 200px;
    background-color: #0e1c2e;
    border-radius: 15px;
    padding: 20px;
    position: relative;
    transition: all 0.3s ease-in-out;
    will-change: transform;
    border: 1px solid transparent;
    border: 1px solid rgba(0, 255, 255, 0.05);
    &:hover {
      background-color: #0e1c2e;
      transform: scale(1.02);
      box-shadow: 0 0 10px rgba(0, 255, 255, 0.548);
      border-radius: 15px;
      border: 1px solid rgba(0, 255, 255);
    }
    & div > img {
      position: absolute;
      transform: rotate(-45deg);
      top: 10px;
      right: 10px;
      width: 25px;
      height: 25px;
      opacity: 0;
      transition: all 0.3s ease-in-out;
      cursor: pointer;
      &:hover {
        transform: rotate(-90deg);
      }
    }
    &:hover div > img {
      opacity: 1;
    }
    & img {
      width: 25px;
      filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.548));
    }
    & h3 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #eef7fb;
      margin: 0;
    }
    & p {
      font-size: 10px;
      text-transform: lowercase;
      color: #949494;
      font-family: 'JetBrains Mono Variable', monospace;
      margin: 0;
    }
  }
  .hidden {
    display: none;
    opacity: 0;
    transform: translateY(10px);
  }
</style>

<script>
  const button = document.getElementById('show-more-btn')

  button?.addEventListener('click', () => {
    document.querySelectorAll('.extra-card').forEach((card) => {
      card.classList.remove('hidden')
    })
    button.remove()
  })
</script>
