---
import type { Explain } from 'src/interfaces/Solutions'
import Steps from '@components/solutions/Steps.astro'

interface Props {
  explain: Explain
}

const { explain } = Astro.props

const {
  title,
  description,
  photo,
  prerequisites = [],
  steps,
  terminal,
  commonErrors = []
} = explain
---

<section class="problem-information">
  <h2 id="informacion-general">Descripción general</h2>
  <h3>{title}</h3>
  <p>{description}</p>

  <div class="articles">
    <!-- Artículo 1: Mapa de síntomas -->
    <article class="article">
      <div class="image-wrapper">
        <img
          src={photo}
          alt={`icono de ${title}`}
          transition:persist=""
          width="20"
        />
      </div>

      <div class="content-wrapper">
        <h3>Síntomas Comunes</h3>
        <h4>Código de error más común</h4>
        <ul class="list-errors">
          {
            commonErrors.map((error) => (
              <li class="item-error">
                <h6>{error.code}</h6>
                <span>
                  <progress value={error.percentage} max="100" />
                  <span>{error.percentage}%</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <!-- Artículo 2: Prerrequisitos -->
    <article class="article">
      <div class="content-wrapper">
        <h3>Prerequisitos</h3>
        <h4>Before you begin</h4>
        <ul>
          {
            prerequisites.map((item) => (
              <li>
                <img
                  src="/info-more/level.svg"
                  alt={`icono de ${item}`}
                  transition:persist=""
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>

  <style>
    .problem-information {
      font-family: 'Bangers', monospace;

      h2 {
        font-size: 0.8rem;
        margin: 0;
        padding: 0;
        color: var(--color-hard);
        text-transform: uppercase;
        letter-spacing: 0.1rem;
      }

      h3 {
        font-size: 1.5rem;
        margin: 20px 0;
        color: var(--color-white);
        letter-spacing: 0.2rem;
      }

      p {
        font-family: 'Grandstander Variable', system-ui;
        line-height: 1.5;
        font-size: 1rem;
        margin: 0;
        padding: 0;
        color: var(--gray-letter);
      }

      & .articles {
        /* BENTO GRID*/
        display: grid;
        grid-template-areas:
          'mapa-sintomas prerrequisitos'
          '. asociaciones';

        grid-template-columns: 3fr 4fr;
        align-items: stretch;
        gap: 1rem;
        margin: 40px 0;

        & .article {
          width: 100%;
          display: flex;
          flex-direction: column;
          border: 1px solid var(--gray-border);
          border-radius: 15px;
          background-color: rgba(0, 0, 0, 0.2);
          overflow: hidden; /* Mantiene los bordes redondeados limpios */
          & > div:nth-child(1) {
            grid-area: mapa-sintomas;
          }
          & > div:nth-child(2) {
            grid-area: prerrequisitos;
          }

          & > div:last-child {
            grid-area: asociaciones;
          }

          & .image-wrapper {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;

            & img {
              width: 100%;
              object-fit: cover; /* Cambiado a cover para mejor adaptación, ajustable a contain si es necesario */
              flex-shrink: 0; /* Evita que el contenido se expanda en la imagen */
              mask-image: linear-gradient(black 90%, transparent);
            }
          }

          & .content-wrapper {
            display: flex;
            flex-direction: column;
            align-items: start;
            justify-content: start;
            gap: 1rem;
            padding: 1rem;
            flex: 1; /* Permite que el contenedor de texto ocupe todo el espacio vertical restante */
            text-wrap: wrap;

            & h3 {
              font-size: 0.8rem;
              margin: 0;
              padding: 0;
              color: var(--color-hard);
              text-transform: uppercase;
              letter-spacing: 0.1rem;
            }

            & h4 {
              font-size: 1rem;
              margin: 0;
              padding: 0;
              color: var(--color-white);
              text-transform: uppercase;
              letter-spacing: 0.1rem;
            }

            & .list-errors {
              word-break: break-word;
              display: flex;
              flex-direction: column;
              gap: 0.5rem;
              overflow: hidden;

              & .item-error {
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;

                & h6 {
                  margin: 0;
                  padding: 0;
                  font-size: 10px;
                }
                & span {
                  display: flex;
                  justify-content: end;
                  align-items: center;
                  gap: 0.3rem;

                  & span {
                    width: 4ch;
                  }

                  & > progress {
                    width: 60px;
                    height: 5px;
                    border-radius: 999px;
                    overflow: hidden;
                    appearance: none;
                    background-color: #e5e7eb;
                  }

                  progress::-webkit-progress-bar {
                    background-color: #e5e7eb;
                  }

                  progress::-webkit-progress-value {
                    background: linear-gradient(
                      90deg,
                      #3b82f6,
                      #6366f1,
                      #8b5cf6
                    );
                    border-radius: 999px;
                    transition: width 0.3s ease;
                  }
                }
              }
            }

            & ul {
              list-style: none;
              padding: 0;
              margin: 0;
              font-size: 0.8rem;
              font-family: 'Grandstander Variable', system-ui;
              display: flex;
              flex-direction: column;
              gap: 0.8rem;
              width: 100%;

              & li {
                color: var(--gray-letter);
                margin: 0;
                padding: 0;
                display: flex;
                align-items: center; /* Alinea ícono y texto verticalmente */
                gap: 0.6rem;

                & img {
                  width: 15px;
                  height: 15px;
                  object-fit: contain;
                  flex-shrink: 0;
                }
              }
            }
          }
        }
      }
    }
  </style>
</section>
