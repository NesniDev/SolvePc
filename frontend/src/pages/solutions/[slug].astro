---
import BlogTitle from '@components/solutions/BlogTitle.astro'
import BlogInformation from '@components/solutions/BlogInformation.astro'
import Layout from '@layouts/Layout.astro'
import { problemasTecnicos as solutions } from '@mockup/solutions'
import Terminal from '@components/solutions/Terminal.astro'
import Steps from '@components/solutions/Steps.astro'
import Help from '@components/solutions/Help.astro'
import SeeMore from '@components/solutions/SeeMore.astro'

export const prerender = false

const { slug } = Astro.params

const API_URL = import.meta.env.PUBLIC_API_URL

const res = await fetch(`${API_URL}/api/solutions/${slug}`, {
  cache: 'force-cache',
  headers: {
    Accept: 'application/json'
  }
})

if (!res.ok) {
  return new Response('Not Found', { status: 404 })
}

const data = await res.json()

const explain = data.explain ?? {}

const safeExplain = {
  title: explain.title ?? '',
  description: explain.description ?? '',
  photo: explain.photo ?? '',
  commonErrors: explain.commonErrors ?? [],
  prerequisites: explain.prerequisites ?? [],
  steps: explain.steps ?? [],
  terminal: explain.terminal ?? ''
}

const {
  title = '',
  description = '',
  category = '',
  difficulty = '',
  image = ''
} = data
---

<Layout>
  <main>
    <div>
      <BlogTitle
        title={title}
        description={description}
        category={category}
        difficulty={difficulty}
        image={image}
      />
      <BlogInformation explain={safeExplain} />
      <Steps explain={safeExplain} />
      <Terminal explain={safeExplain} />
      <Help />
    </div>
    <SeeMore />
  </main>
</Layout>

<style>
  main {
    max-width: 1000px;
    display: flex;
    flex-direction: row;
    align-items: start;
    gap: 2rem;
    margin: 0 auto;
  }
</style>
